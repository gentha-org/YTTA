# Telegram Bot Token (dapatkan dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Group Chat ID (dapatkan dari bot setelah ditambahkan ke grup)
TELEGRAM_GROUP_CHAT_ID=your_group_chat_id_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

# Iuran Bulanan per Orang (dalam Rupiah) - bisa diubah nanti
MONTHLY_CONTRIBUTION=0

# Budget Bulanan (dalam Rupiah) - bisa diubah nanti
MONTHLY_BUDGET=0
